# Prefer ./install.sh: it writes private configuration outside this checkout.
FASTMAIL_EMAIL="you@example.com"
FASTMAIL_APP_PASSWORD=""
FASTMAIL_HOST="imap.fastmail.com"
FASTMAIL_SMTP_HOST="smtp.fastmail.com"
OPENROUTER_API_KEY=""
# GEMINI_API_KEY=""  # legacy standalone classifier only; direct writing is disabled

# Use absolute paths. The setup script fills these in for you.
DATA_DIR="/home/you/.config/tahor/data"
PROMPT_PATH="/home/you/.config/tahor/data/prompt.txt"
TAHOR_DB_PATH="/home/you/.config/tahor/state/decisions.db"
TAHOR_SETTINGS_PATH="/home/you/.config/tahor/state/settings.json"
TAHOR_STATE_DIR="/home/you/.config/tahor/state"

BASE_URL="http://localhost:8420"
ALLOWED_EMAIL="you@example.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TAHOR_DATA_PUSH="0"
TAHOR_NOTIFY_DRAFTS="0"

# Optional unread notices in your own inbox; uses existing IMAP access.
# Enable the separate tahor-notifications.timer after choosing these settings.
TAHOR_NOTIFY_HEALTH="0"
TAHOR_NOTIFY_DIGEST="0"
TAHOR_NOTIFY_TIMEZONE="UTC"
TAHOR_NOTIFY_HOUR="9"

# FILING_ROOT="Filed"
# RETENTION_TRANSIENT_DAYS="7"
# RETENTION_STANDARD_DAYS="1095"
# Settings → Time in the inbox overrides these filing-only fallback values.
# FILING_READ_MIN_AGE_DAYS="3"
# FILING_UNREAD_MIN_AGE_DAYS="7"
